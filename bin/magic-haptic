#!/usr/bin/env python3
"""Magic Trackpad 2 / USB-C haptic feedback control.

Watches the touchpad's pressure stream and fires the Taptic Engine
(one-shot actuator report 0x53) when pressure crosses the click threshold,
like macOS host click mode.

Usage:
  magic-haptic status            show stored click/release haptic values
  magic-haptic low|medium|high|silent|off   set firmware haptic strength
  magic-haptic debug             diagnose click detection + actuator
  magic-haptic daemon            run haptic-on-click daemon (foreground)
  magic-haptic install-service   install + start systemd service
  magic-haptic install-udev      install udev rule that re-applies strength
"""
import ctypes
import fcntl
import glob
import os
import select
import struct
import sys
import time

STRENGTHS = {
    "low": (0x040415, 0x000010),
    "medium": (0x060617, 0x000014),
    "high": (0x08081E, 0x020218),
    "silent": (0x000015, 0x000010),
    "off": (0x000000, 0x000000),
}

PRESSURE_DOWN = 64
PRESSURE_UP = 38

CONFIG_TEMPLATE = [0x00, 0x01, 0x00, 0x78, 0x02, 0x00, 0x24,
                   0x30, 0x06, 0x01, 0x00, 0x18, 0x48, 0x13]
VIB_TEMPLATE = [0x53, 0x01, 0x00, 0x78, 0x02, 0x00, 0x24,
                0x30, 0x06, 0x01, 0x00, 0x18, 0x48, 0x12]
REPORT_LEN = 14
CLICK_ID = 0x22
RELEASE_ID = 0x23
BTN_MOUSE = 0x110
EV_KEY = 0x01
EV_ABS = 0x03
ABS_MT_PRESSURE = 0x3A

CONF = os.path.expanduser("~/.config/magic-haptic.conf")
UDEV_RULE = "/etc/udev/rules.d/99-magic-haptic.rules"
SERVICE = "/etc/systemd/system/magic-haptic.service"
SCRIPT_PATH = os.path.abspath(__file__)


def _ioc(direction, kind, nr, size):
    return (direction << 30) | (size << 16) | (kind << 8) | nr


def hidraw_get(dev, size):
    fd = os.open(dev, os.O_RDWR)
    try:
        buf = bytearray(size)
        fcntl.ioctl(fd, _ioc(3, ord("H"), 0x07, size), buf, True)
        return bytes(buf)
    finally:
        os.close(fd)


def hidraw_set(dev, buf):
    fd = os.open(dev, os.O_RDWR)
    try:
        fcntl.ioctl(fd, _ioc(3, ord("H"), 0x06, len(buf)), bytes(buf), True)
    finally:
        os.close(fd)


def find_transport():
    usb, bt = None, None
    for sysfs in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = dict(
            p.split("=", 1)
            for p in open(os.path.join(sysfs, "device", "uevent")).read().splitlines()
            if "=" in p
        )
        parts = uevent.get("HID_ID", "").split(":")
        if (
            len(parts) != 3
            or parts[1] not in ("000005AC", "0000004C")
            or parts[2] not in ("00000265", "00000324")
        ):
            continue
        if parts[0] == "0005":
            bt = "/dev/" + os.path.basename(sysfs)
        elif parts[0] == "0003":
            desc = open(os.path.join(sysfs, "device", "report_descriptor"), "rb").read()
            if b"\x85\x53" in desc:
                usb = "/dev/" + os.path.basename(sysfs)
    if usb:
        return "usb", usb
    if bt:
        return "bt", bt
    return None, None


def find_haptic_hidraw():
    _, dev = find_transport()
    return dev


def find_trackpad_evdevs():
    result = []
    for block in open("/proc/bus/input/devices").read().split("\n\n"):
        if "Magic Trackpad" not in block:
            continue
        sysfs = next(
            ("/sys" + l.split("=", 1)[1].strip() for l in block.splitlines() if l.startswith("S: ")),
            None,
        )
        for line in block.splitlines():
            if line.startswith("H: "):
                for handler in line[3:].replace("Handlers=", "").split():
                    if handler.startswith("event"):
                        node = "/dev/input/" + handler
                        has_pressure = False
                        try:
                            absbits = int(
                                open(os.path.join(sysfs, "capabilities", "abs")).read().split()[0],
                                16,
                            )
                            has_pressure = bool((absbits >> ABS_MT_PRESSURE) & 1)
                        except (OSError, ValueError):
                            pass
                        result.append((node, has_pressure))
    return result


def find_evdev():
    candidates = find_trackpad_evdevs()
    for node, has_pressure in candidates:
        if has_pressure:
            return node
    return candidates[0][0] if candidates else None


def build_config(report_id, feedback, transport="usb"):
    buf = list(CONFIG_TEMPLATE)
    buf[0] = report_id
    _embed(buf, feedback)
    if transport == "bt":
        return bytes([0xF2] + buf)
    return bytes(buf)


def build_vib(feedback, transport="usb"):
    buf = _embed(list(VIB_TEMPLATE), feedback)
    if transport == "bt":
        return bytes([0xF2] + buf)
    buf[8] = buf[10]
    return bytes(buf)


def host_mode_bytes(on, transport="usb"):
    if transport == "bt":
        return bytes([0xF2, 0x21, 1 if on else 0])
    return bytes([0x21, 1 if on else 0])


def _embed(buf, feedback):
    buf[2] = feedback & 0xFF
    buf[5] = (feedback >> 8) & 0xFF
    buf[10] = (feedback >> 16) & 0xFF
    return buf


def status():
    transport, dev = find_transport()
    if not dev:
        sys.exit("Magic Trackpad not found")
    print("transport:", transport, "| device:", dev)
    for name, rid in (("click", CLICK_ID), ("release", RELEASE_ID)):
        try:
            raw = hidraw_get(dev, REPORT_LEN)
            if raw[0] == rid:
                value = raw[10] << 16 | raw[5] << 8 | raw[2]
                print(f"{name}: 0x{value:06x}")
            else:
                print(f"{name}: unreadable (got report 0x{raw[0]:02x})")
        except OSError as e:
            print(f"{name}: unreadable ({e})")


def load_strength():
    if os.path.exists(CONF):
        saved = open(CONF).read().strip()
        if saved in STRENGTHS:
            return saved
    return "medium"


def save_strength(name):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write(name)


def parse_events(data, remainder):
    events = remainder + data
    n = len(events) // 24 * 24
    return struct.iter_unpack("<2q2Hi", events[:n]), events[n:]


class Haptic:
    def __init__(self, hid_fd, strength=None, transport="usb"):
        self.hid = hid_fd
        click, release = STRENGTHS[strength or load_strength()]
        self.vib_down = build_vib(click, transport)
        self.vib_up = build_vib(release, transport)
        self.pressed = False

    def on_pressure(self, p):
        if not self.pressed and p >= PRESSURE_DOWN:
            self.pressed = True
            try:
                os.write(self.hid, self.vib_down)
            except OSError:
                raise
        elif self.pressed and p <= PRESSURE_UP:
            self.pressed = False
            try:
                os.write(self.hid, self.vib_up)
            except OSError:
                raise

    def on_button(self, v):
        if v == 1 and not self.pressed:
            self.pressed = True
            os.write(self.hid, self.vib_down)
        elif v == 0 and self.pressed:
            self.pressed = False
            os.write(self.hid, self.vib_up)


def debug():
    transport, dev = find_transport()
    candidates = find_trackpad_evdevs()
    print("transport:", transport, "| hidraw:", dev)
    print("evdev candidates:", candidates)
    if not dev or not candidates:
        sys.exit("devices not found")

    vib_down = build_vib(STRENGTHS[load_strength()][0], transport)
    hid = os.open(dev, os.O_RDWR)
    fds = {}
    for node, _ in candidates:
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = os.path.basename(node)
        except OSError as e:
            print(f"cannot open {node}: {e}")

    def host_mode(on):
        buf = host_mode_bytes(on, transport)
        ret = fcntl.ioctl(
            hid, _ioc(3, ord("H"), 0x06, len(buf)), buf, True
        )
        print(f"  host mode {'on' if on else 'off'}: ioctl ret {bytes(ret)!r}")

    def buzz(n, label):
        for _ in range(n):
            try:
                ret = os.write(hid, vib_down)
                print(f"  {label}: wrote {ret} bytes", flush=True)
            except OSError as e:
                print(f"  {label}: FAILED {e}", flush=True)
            time.sleep(0.5)

    try:
        print("\nphase 1: host mode FIRST, then 2 buzzes", flush=True)
        host_mode(True)
        time.sleep(0.3)
        buzz(2, "buzz")

        print("\nphase 2: host mode stays ON, 10s live — press/click NOW", flush=True)
        haptic = Haptic(hid, transport=transport)
        end = time.time() + 10
        clicks = 0
        remainder = {}
        while time.time() < end:
            r, _, _ = select.select(list(fds), [], [], 0.5)
            for fd in r:
                node = fds[fd]
                try:
                    data = os.read(fd, 512)
                except BlockingIOError:
                    continue
                evs, remainder[node] = parse_events(data, remainder.get(node, b""))
                for _, _, typ, code, value in evs:
                    if typ == EV_ABS and code == ABS_MT_PRESSURE:
                        if value >= PRESSURE_DOWN and not haptic.pressed:
                            print(f"  [{node}] pressure {value} -> vib_down", flush=True)
                        haptic.on_pressure(value)
                    elif typ == EV_KEY and code == BTN_MOUSE:
                        clicks += 1
                        print(f"  [{node}] BTN_MOUSE -> {value}", flush=True)
        print("BTN_MOUSE events:", clicks)
        host_mode(False)
        print("\nQ1: did you feel the 2 buzzes in phase 1 (host mode first)?")
        print("Q2: in phase 2, did every press/click buzz?")
    finally:
        os.close(hid)
        for fd in fds:
            os.close(fd)


def daemon():
    while True:
        dev = find_haptic_hidraw()
        candidates = find_trackpad_evdevs()
        nodes = [n for n, has_p in candidates if has_p] or [n for n, _ in candidates]
        if not dev or not nodes:
            print(f"daemon: waiting (hidraw={dev}, evdevs={nodes})", flush=True)
            time.sleep(2)
            continue
        try:
            hid = os.open(dev, os.O_WRONLY)
            haptic = Haptic(hid, transport=transport)
            fds = {}
            for node in nodes:
                try:
                    fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
                except OSError:
                    pass
            print(f"daemon: active (haptic={dev}, watching {len(fds)} device(s))", flush=True)
            remainder = {}
            while True:
                r, _, _ = select.select(list(fds), [], [], None)
                for fd in r:
                    try:
                        data = os.read(fd, 512)
                    except (BlockingIOError, OSError):
                        continue
                    evs, remainder[fds[fd]] = parse_events(data, remainder.get(fds[fd], b""))
                    for _, _, typ, code, value in evs:
                        if typ == EV_ABS and code == ABS_MT_PRESSURE:
                            haptic.on_pressure(value)
                        elif typ == EV_KEY and code == BTN_MOUSE:
                            haptic.on_button(value)
        except OSError:
            time.sleep(2)
        finally:
            try:
                os.close(hid)
            except Exception:
                pass
            for fd in fds:
                try:
                    os.close(fd)
                except Exception:
                    pass


def probe():
    if os.geteuid() != 0:
        sys.exit("run with sudo")
    for sysfs in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        uevent = dict(
            part.split("=", 1)
            for part in open(os.path.join(sysfs, "device", "uevent")).read().splitlines()
            if "=" in part
        )
        parts = uevent.get("HID_ID", "").split(":")
        if not (
            len(parts) == 3
            and parts[1] == "000005AC"
            and parts[2] in ("00000265", "00000324")
        ):
            continue
        dev = "/dev/" + os.path.basename(sysfs)
        print(f"== {dev} ({uevent.get('HID_PHYS')})")
        for rid, label in ((0x21, "host-mode"), (0x22, "click-cfg"), (0x23, "release-cfg")):
            try:
                raw = hidraw_get(dev, 14)
                print(f"   GET 0x{rid:02x} ({label}): {raw.hex(' ')}")
            except OSError as e:
                print(f"   GET 0x{rid:02x} ({label}): error {e}")


USBDEVFS_CONTROL = _ioc(3, ord("U"), 0, 24)


def find_usb_devnode():
    sysfs = glob.glob("/sys/class/hidraw/hidraw*/device/../..")
    dev = find_haptic_hidraw()
    if not dev:
        return None
    base = os.path.realpath(f"/sys/class/hidraw/{os.path.basename(dev)}/device")
    while base and base != "/":
        if os.path.exists(os.path.join(base, "busnum")):
            bus = int(open(os.path.join(base, "busnum")).read())
            num = int(open(os.path.join(base, "devnum")).read())
            return f"/dev/bus/usb/{bus:03d}/{num:03d}"
        base = os.path.dirname(base)
    return None


def usb_control(usbfd, bmRequestType, bRequest, wValue, wIndex, data, timeout=1000):
    buf = ctypes.create_string_buffer(bytes(data), len(data))
    ctrl = struct.pack(
        "<BBHHHI4x", bmRequestType, bRequest, wValue, wIndex, len(data), timeout
    )
    ctrl += ctypes.addressof(buf).to_bytes(8, "little")
    ret = fcntl.ioctl(usbfd, USBDEVFS_CONTROL, ctrl, True)
    return ret


def ctltest():
    if os.geteuid() != 0:
        sys.exit("run with sudo")
    devnode = find_usb_devnode()
    if not devnode:
        sys.exit("usb device node not found")
    print("usb devnode:", devnode)
    vib = build_vib(STRENGTHS[load_strength()][0])
    usbfd = os.open(devnode, os.O_RDWR)
    try:
        print("\nstep 1: control SET_REPORT(FEATURE) 0x21=1 -> interface 2")
        try:
            usb_control(usbfd, 0x21, 9, 0x0321, 2, [0x21, 0x01])
            print("  ok")
        except OSError as e:
            print("  failed:", e)
        time.sleep(0.3)

        print("step 2: 2 vib via interrupt OUT (hidraw write)")
        for _ in range(2):
            hid = os.open(find_haptic_hidraw(), os.O_WRONLY)
            os.write(hid, vib)
            os.close(hid)
            print("  sent")
            time.sleep(1.0)

        print("step 3: 2 vib via CONTROL SET_REPORT(OUTPUT) -> interface 2")
        for _ in range(2):
            try:
                usb_control(usbfd, 0x21, 9, 0x0253, 2, vib)
                print("  ok")
            except OSError as e:
                print("  failed:", e)
            time.sleep(1.0)

        print("step 4: 2 vib via CONTROL SET_REPORT(OUTPUT) -> interface 1")
        for _ in range(2):
            try:
                usb_control(usbfd, 0x21, 9, 0x0253, 1, vib)
                print("  ok")
            except OSError as e:
                print("  failed:", e)
            time.sleep(1.0)

        print("disabling host mode again")
        try:
            usb_control(usbfd, 0x21, 9, 0x0321, 2, [0x21, 0x00])
        except OSError:
            pass
        print("\nQ: which steps (1-4) produced a felt buzz?")
    finally:
        os.close(usbfd)


def try1():
    if os.geteuid() != 0:
        sys.exit("run with sudo")
    candidates = find_trackpad_evdevs()
    haptic_dev = find_haptic_hidraw()
    # touch interface = the hidraw of interface input1 (answers control reqs)
    ifaces = sorted(glob.glob("/sys/class/hidraw/hidraw*"))
    touch = None
    for sysfs in ifaces:
        uevent = dict(
            p.split("=", 1)
            for p in open(os.path.join(sysfs, "device", "uevent")).read().splitlines()
            if "=" in p
        )
        if uevent.get("HID_PHYS", "").endswith("input1"):
            parts = uevent.get("HID_ID", "").split(":")
            if len(parts) == 3 and parts[1] == "000005AC" and parts[2] in (
                "00000265",
                "00000324",
            ):
                touch = "/dev/" + os.path.basename(sysfs)
    if not touch or not haptic_dev:
        sys.exit(f"missing: touch={touch} haptic={haptic_dev}")
    print("touch interface:", touch, "| haptic interface:", haptic_dev)

    def show(dev, rid, label):
        try:
            raw = hidraw_get(dev, 14)
            print(f"  GET {label} from {dev}: {raw.hex(' ')}")
            return raw
        except OSError as e:
            print(f"  GET {label} from {dev}: error {e}")
            return None

    click, release = STRENGTHS["medium"]
    print("\nbefore:")
    before22 = show(touch, 0x22, "click-cfg")
    show(touch, 0x21, "host-mode")

    print("\nSET medium click config via touch interface")
    hidraw_set(touch, build_config(0x22, click))
    hidraw_set(touch, build_config(0x23, release))
    after22 = show(touch, 0x22, "click-cfg")
    show(touch, 0x23, "release-cfg")
    if after22 and before22 and after22 != before22:
        print("  >>> config READBACK CHANGED - it landed!")
    else:
        print("  >>> readback unchanged (inconclusive: may be write-only)")

    print("\nlisten 10s: CLICK the trackpad (autonomous haptic test)")
    fds = {}
    for node, _ in candidates:
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
        except OSError:
            pass
    clicks = 0
    end = time.time() + 10
    remainder = {}
    while time.time() < end:
        r, _, _ = select.select(list(fds), [], [], 0.5)
        for fd in r:
            try:
                data = os.read(fd, 512)
            except (BlockingIOError, OSError):
                continue
            evs, remainder[fds[fd]] = parse_events(data, remainder.get(fds[fd], b""))
            for _, _, typ, code, value in evs:
                if typ == EV_KEY and code == BTN_MOUSE:
                    clicks += 1
                    print(f"  [{fds[fd]}] BTN_MOUSE -> {value}", flush=True)
    print("clicks:", clicks)
    print("Q1: did the clicks buzz at click time?")

    print("\nhost mode via touch interface + 2 vib via haptic interface")
    hidraw_set(touch, bytes([0x21, 0x01]))
    show(touch, 0x21, "host-mode")
    hid = os.open(haptic_dev, os.O_WRONLY)
    vib = build_vib(click)
    for _ in range(2):
        os.write(hid, vib)
        print("  vib sent")
        time.sleep(1.0)
    print("Q2: felt these 2?")

    print("\nlive 10s: pressure + click haptics (host mode on)")
    haptic = Haptic(hid)
    end = time.time() + 10
    while time.time() < end:
        r, _, _ = select.select(list(fds), [], [], 0.5)
        for fd in r:
            try:
                data = os.read(fd, 512)
            except (BlockingIOError, OSError):
                continue
            evs, remainder[fds[fd]] = parse_events(data, remainder.get(fds[fd], b""))
            for _, _, typ, code, value in evs:
                if typ == EV_ABS and code == ABS_MT_PRESSURE:
                    if value >= PRESSURE_DOWN and not haptic.pressed:
                        print(f"  pressure {value} -> vib_down", flush=True)
                    haptic.on_pressure(value)
    hidraw_set(touch, bytes([0x21, 0x00]))
    os.close(hid)
    for fd in fds:
        os.close(fd)
    print("Q3: did presses buzz in the live phase?")


def fullmatrix():
    if os.geteuid() != 0:
        sys.exit("run with sudo")
    devnode = find_usb_devnode()
    if not devnode:
        sys.exit("usb devnode not found")
    print("usb devnode:", devnode)

    hid_devs = []
    usb_ifaces = []
    for sysfs in glob.glob("/sys/class/hidraw/hidraw*"):
        uevent = dict(
            p.split("=", 1)
            for p in open(os.path.join(sysfs, "device", "uevent")).read().splitlines()
            if "=" in p
        )
        parts = uevent.get("HID_ID", "").split(":")
        if len(parts) == 3 and parts[1] == "000005AC" and parts[2] in (
            "00000265",
            "00000324",
        ):
            hid_devs.append(os.path.basename(os.path.realpath(sysfs + "/device")))
            usb_ifaces.append(os.path.basename(os.path.realpath(sysfs + "/device/..")))
    hid_devs = sorted(set(hid_devs))
    usb_ifaces = sorted(set(usb_ifaces))
    print("hid devices:", hid_devs)

    print("\n== unbinding usbhid transport (touchpad input goes dead ~1 min)")
    for iface in usb_ifaces:
        try:
            with open("/sys/bus/usb/drivers/usbhid/unbind", "w") as f:
                f.write(iface)
            print("  unbound", iface)
        except OSError as e:
            print(f"  unbind {iface}: {e}")

    usbfd = os.open(devnode, os.O_RDWR)
    click, release = STRENGTHS["medium"]
    vib_down = build_vib(click)

    def fire(label, wIndex_list):
        for wIndex in wIndex_list:
            for _ in range(2):
                try:
                    usb_control(usbfd, 0x21, 9, 0x0253, wIndex, vib_down)
                    print(f"  {label} (if{wIndex}): sent")
                except OSError as e:
                    print(f"  {label} (if{wIndex}): FAILED {e}")
                time.sleep(1.2)

    try:
        print("\nstep 1: vib via CONTROL OUTPUT, both interfaces")
        fire("vib", (2, 1))

        print("step 2: host mode ON (control, if2), vib again")
        try:
            usb_control(usbfd, 0x21, 9, 0x0321, 2, [0x21, 0x01])
            print("  host mode: ok")
        except OSError as e:
            print("  host mode: FAILED", e)
        time.sleep(0.3)
        fire("vib", (2, 1))

        print("step 3: config medium (control, if2+if1), vib again")
        for wIndex in (2, 1):
            try:
                usb_control(usbfd, 0x21, 9, 0x0322, wIndex, build_config(0x22, click))
                usb_control(usbfd, 0x21, 9, 0x0323, wIndex, build_config(0x23, release))
                print(f"  config if{wIndex}: ok")
            except OSError as e:
                print(f"  config if{wIndex}: FAILED {e}")
        time.sleep(0.3)
        fire("vib", (2, 1))

        print("step 4: host mode off, rebinding driver")
        try:
            usb_control(usbfd, 0x21, 9, 0x0321, 2, [0x21, 0x00])
        except OSError:
            pass
    finally:
        os.close(usbfd)
        for iface in usb_ifaces:
            try:
                with open("/sys/bus/usb/drivers/usbhid/bind", "w") as f:
                    f.write(iface)
                print("  rebound", iface)
            except OSError as e:
                print(f"  bind {iface}: {e}")
    time.sleep(2)
    print("\nQ: which steps (1/2/3) buzzed?")
    print("final: click the trackpad 5 times now — 10s autonomous test")
    fds = {}
    for node, _ in find_trackpad_evdevs():
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
        except OSError:
            pass
    clicks = 0
    end = time.time() + 10
    remainder = {}
    while time.time() < end:
        r, _, _ = select.select(list(fds), [], [], 0.5)
        for fd in r:
            try:
                data = os.read(fd, 512)
            except (BlockingIOError, OSError):
                continue
            evs, remainder[fds[fd]] = parse_events(data, remainder.get(fds[fd], b""))
            for _, _, typ, code, value in evs:
                if typ == EV_KEY and code == BTN_MOUSE:
                    clicks += 1
    print("clicks detected:", clicks)
    for fd in fds:
        os.close(fd)
    print("Q2: did any of those clicks buzz on their own?")


def trybt():
    if os.geteuid() != 0:
        sys.exit("run with sudo")
    transport, dev = find_transport()
    if transport != "bt":
        sys.exit("trackpad not connected over Bluetooth")
    click, release = STRENGTHS["medium"]

    print("disabling host mode (autonomous mode)")
    hidraw_set(dev, host_mode_bytes(False, "bt"))

    print("sending medium haptic config over BT")
    hidraw_set(dev, build_config(CLICK_ID, click, "bt"))
    hidraw_set(dev, build_config(RELEASE_ID, release, "bt"))
    print("  config sent")

    fds = {}
    for node, _ in find_trackpad_evdevs():
        try:
            fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
        except OSError:
            pass
    print("\nCLICK the trackpad repeatedly for 12s (autonomous haptic test)")
    clicks = 0
    end = time.time() + 12
    remainder = {}
    while time.time() < end:
        r, _, _ = select.select(list(fds), [], [], 0.5)
        for fd in r:
            try:
                data = os.read(fd, 512)
            except (BlockingIOError, OSError):
                continue
            evs, remainder[fds[fd]] = parse_events(data, remainder.get(fds[fd], b""))
            for _, _, typ, code, value in evs:
                if typ == EV_KEY and code == BTN_MOUSE and value == 1:
                    clicks += 1
                    print("  click", flush=True)
    print("clicks:", clicks)
    for fd in fds:
        os.close(fd)
    print("Q: did any click buzz on its own at click time?")

    print("\nthen: host mode ON + 2 vib")
    hidraw_set(dev, host_mode_bytes(True, "bt"))
    hid = os.open(dev, os.O_RDWR)
    os.write(hid, build_vib(click, "bt"))
    print("  vib sent")
    time.sleep(1.2)
    os.write(hid, build_vib(click, "bt"))
    print("  vib sent")
    time.sleep(1.2)
    os.close(hid)
    hidraw_set(dev, host_mode_bytes(False, "bt"))
    print("host mode off (feature report)")
    print("Q2: felt these 2?")


UNIT = f"""[Unit]
Description=Magic Trackpad haptic click feedback

[Service]
ExecStart=/usr/bin/python3 {SCRIPT_PATH} daemon
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
"""


def main():
    if len(sys.argv) != 2:
        print(__doc__.strip())
        sys.exit(1)
    cmd = sys.argv[1]

    if cmd == "status":
        status()
        return

    if cmd == "hostoff":
        transport, dev = find_transport()
        if not dev:
            sys.exit("Magic Trackpad not found")
        hidraw_set(dev, host_mode_bytes(False, transport))
        print(f"host click mode disabled via {transport} feature report")
        return

    if cmd == "trybt":
        trybt()
        return

    if cmd == "fullmatrix":
        fullmatrix()
        return

    if cmd == "try1":
        try1()
        return

    if cmd == "ctltest":
        ctltest()
        return

    if cmd == "probe":
        probe()
        return

    if cmd == "debug":
        debug()
        return

    if cmd == "daemon":
        daemon()
        return

    if cmd == "install-service":
        if os.geteuid() != 0:
            sys.exit("run with sudo")
        with open(SERVICE, "w") as f:
            f.write(UNIT)
        os.system("systemctl daemon-reload && systemctl enable --now magic-haptic")
        print("service installed and started:", SERVICE)
        print("check with: systemctl status magic-haptic")
        return

    if cmd == "install-udev":
        if os.geteuid() != 0:
            sys.exit("run with sudo")
        with open(UDEV_RULE, "w") as f:
            f.write(
                'ACTION=="add", SUBSYSTEM=="hidraw", '
                'ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", '
                f'RUN+="/usr/bin/python3 {SCRIPT_PATH} restore"\n'
            )
        os.system("udevadm control -R")
        print("udev rule installed:", UDEV_RULE)
        return

    if cmd == "restore":
        if os.path.exists(CONF):
            cmd = open(CONF).read().strip()
        else:
            return

    if cmd not in STRENGTHS:
        print(__doc__.strip())
        sys.exit(1)

    transport, dev = find_transport()
    if not dev:
        sys.exit("Magic Trackpad not found")

    if os.geteuid() != 0:
        sys.exit("run with sudo (hidraw is root-only)")

    click, release = STRENGTHS[cmd]
    hidraw_set(dev, build_config(CLICK_ID, click, transport))
    hidraw_set(dev, build_config(RELEASE_ID, release, transport))
    print(f"set haptic strength to '{cmd}' ({transport}) on {dev}")

    save_strength(cmd)


if __name__ == "__main__":
    main()
